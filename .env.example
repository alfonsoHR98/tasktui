# Copia este archivo a .env y cambia los valores (nunca subas .env al repo).
# Genera un token con:  openssl rand -hex 24
API_TOKEN=
# Opcional: activa el servidor MCP en /mcp/<MCP_SECRET>  (openssl rand -hex 24)
MCP_SECRET=
# Zona horaria para «hoy»: minutos respecto a UTC (México = -360, España en invierno = 60)
TZ_OFFSET_MINUTES=0
