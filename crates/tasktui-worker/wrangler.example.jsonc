// Servidor de tasktui en Cloudflare Workers + D1.
// Para tu propia instancia (guía completa en docs/cloudflare.md):
//   1. cp wrangler.example.jsonc wrangler.jsonc   (wrangler.jsonc no se sube al repo)
//   2. npx wrangler d1 create tasktui   → pega abajo el `database_id` que imprime
//   3. cambia `routes` por tu dominio (o bórralo y pon "workers_dev": true)
//   4. npx wrangler secret put API_TOKEN
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tasktui",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-11-06",
  "build": {
    "command": "worker-build --release"
  },
  // La página web (web/) se sirve como archivos estáticos; /api/* va al Worker.
  "assets": {
    "directory": "./web",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasktui",
      "database_id": "PEGA-AQUI-EL-ID-DE-TU-BASE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Zona horaria para «hoy» cuando el cliente no manda ?hoy= (Ciudad de México: UTC-6).
    "TZ_OFFSET_MINUTES": "-360"
  },
  "routes": [
    { "pattern": "tareas.tu-dominio.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
}
