// Servidor de tasktui en Cloudflare Workers + D1.
// Para tu propia instancia: crea la base (`npx wrangler d1 create tasktui`),
// pon su `database_id` abajo, cambia `routes` por tu dominio y define el token:
//   npx wrangler secret put API_TOKEN
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tasktui",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-11-06",
  "build": {
    "command": "worker-build --release"
  },
  // La página web (web/) se sirve como archivos estáticos; /api/* va al Worker.
  "assets": {
    "directory": "./web",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasktui",
      "database_id": "9db65d7b-c33d-4638-aaed-aa38192ed6f8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Zona horaria para «hoy» cuando el cliente no manda ?hoy= (Ciudad de México: UTC-6).
    "TZ_OFFSET_MINUTES": "-360"
  },
  "routes": [
    { "pattern": "tasks.madara.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
}
